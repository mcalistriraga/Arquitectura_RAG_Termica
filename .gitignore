# ============================================================
# Arquitectura RAG local con supervisión térmica
# Archivo: .gitignore
# Versión: 0.5.1 (Actualizado: 26-Ago-2026)
# ============================================================

# ----------------------------
# Python / Artefactos de ejecución
# ----------------------------
__pycache__/
*.pyc
*.pyo
*.pyd

# Entornos virtuales
venv/
venv_rag/
.venv/

# ----------------------------
# Logs & Auditoría de sesión
# ----------------------------
*.log
*.tmp
query_log.txt
thermal_watchdog_log.txt

# ----------------------------
# Red / Descubrimiento dinámico de IP
# ----------------------------
windows_ip.txt

# ----------------------------
# Respaldos y archivos temporales
# ----------------------------
*.bak
*.old
*.orig
*~

# ----------------------------
# Entorno & Credenciales de Seguridad (OpenRouter / APIs)
# ----------------------------
*.env
.env
.env.*

# ----------------------------
# IDEs & Editores
# ----------------------------
.vscode/
.idea/

# ----------------------------
# Sistema operativo (Windows / macOS)
# ----------------------------
Thumbs.db
Desktop.ini
*:Zone.Identifier
.DS_Store